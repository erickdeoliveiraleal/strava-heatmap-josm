{
  "manifest_version": 3,
  "name": "Strava Heatmap → JOSM",
  "version": "1.4",
  "description": "Gera a URL TMS do Strava Global Heatmap para JOSM/iD, com os cookies necessários no header.",
  "homepage_url": "https://github.com/erickdeoliveiraleal/strava-heatmap-josm",
  "permissions": ["cookies", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://*.strava.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Strava Heatmap → JOSM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
